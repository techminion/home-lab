# Copy to config.env (git-ignored) and fill in.
#   cp config.env.example config.env && $EDITOR config.env
#
# Every value is optional; blanks are skipped. Nothing here is secret enough
# to worry about EXCEPT don't commit config.env — it's in .gitignore already.

# --- git identity (used by modules/git.sh) ---
GIT_USER_NAME="TechMinion"
GIT_USER_EMAIL="thetechminion@gmail.com"
# Optional: sign commits with SSH key. Leave blank to skip.
GIT_SIGNING_KEY=""              # e.g. ~/.ssh/id_ed25519.pub

# --- which modules to run (space separated) ---
# Full set: packages zsh git podman tailscale
MODULES="packages zsh git podman tailscale"

# --- tailscale ---
# Login is interactive (browser) by default. Extra flags for `tailscale up`:
TAILSCALE_FLAGS="--ssh"         # e.g. "--ssh --accept-routes"
# Optional hostname override; blank keeps the device's own hostname.
TAILSCALE_HOSTNAME=""

# --- zsh ---
ZSH_THEME="agnoster"
