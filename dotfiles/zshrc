# Managed by home-lab (symlinked from repo dotfiles/zshrc). Edit in the repo.

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="${ZSH_THEME:-agnoster}"
plugins=(git z fzf zsh-autosuggestions zsh-syntax-highlighting)
source "$ZSH/oh-my-zsh.sh"

# --- PATH / brew (macOS) ---
[[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"
[[ -x /usr/local/bin/brew   ]] && eval "$(/usr/local/bin/brew shellenv)"

# --- aliases ---
alias ll='ls -lah'
alias gs='git status'
alias gd='git diff'
alias k='kubectl'
alias pc='podman-compose'
alias tsup='sudo tailscale up'
alias tsst='tailscale status'
# Debian ships bat as batcat
command -v batcat >/dev/null 2>&1 && alias bat='batcat'

# --- fzf ---
[[ -f ~/.fzf.zsh ]] && source ~/.fzf.zsh

# --- local, per-device overrides (git-ignored, not managed) ---
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
